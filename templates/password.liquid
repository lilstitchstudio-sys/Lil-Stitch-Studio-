<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Lil Stitch Studio</title>

  {{ content_for_header }}

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      background: #f7eee9;
      color: #4b3f3b;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .password-page {
      width: 100%;
      max-width: 520px;
      text-align: center;
    }

    .password-card {
      background: #fffaf7;
      border-radius: 28px;
      padding: 44px 28px;
      box-shadow: 0 14px 40px rgba(91, 70, 62, 0.10);
      border: 1px solid #eadbd4;
    }

    .stork {
      font-size: 54px;
      margin-bottom: 8px;
    }

    h1 {
      margin: 0;
      font-size: 38px;
      line-height: 1.1;
      font-weight: 700;
      color: #5a4740;
    }

    .tagline {
      margin-top: 10px;
      font-size: 14px;
      letter-spacing: 1.7px;
      text-transform: uppercase;
      color: #b7877c;
    }

    .coming-soon {
      margin: 30px 0 10px;
      font-size: 21px;
      font-weight: 600;
      color: #5a4740;
    }

    .message {
      font-size: 15px;
      line-height: 1.7;
      color: #796860;
      max-width: 380px;
      margin: 0 auto 28px;
    }

    .password-form {
      display: flex;
      gap: 10px;
      max-width: 380px;
      margin: 0 auto;
    }

    .password-form input[type="password"] {
      flex: 1;
      min-width: 0;
      border: 1px solid #dbc5bc;
      border-radius: 50px;
      padding: 14px 18px;
      font-size: 15px;
      background: white;
      outline: none;
      color: #4b3f3b;
    }

    .password-form input[type="password"]:focus {
      border-color: #b7877c;
    }

    .password-form button {
      border: none;
      border-radius: 50px;
      padding: 14px 22px;
      background: #b7877c;
      color: white;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .password-form button:hover {
      opacity: .9;
    }

    .errors {
      color: #a54f4f;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .footer-text {
      margin-top: 28px;
      font-size: 13px;
      color: #9b8880;
    }

    @media (max-width: 500px) {
      .password-card {
        padding: 38px 20px;
      }

      h1 {
        font-size: 32px;
      }

      .password-form {
        flex-direction: column;
      }

      .password-form button {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <main class="password-page">

    <div class="password-card">

      <div class="stork">🤍</div>

      <h1>Lil Stitch Studio</h1>

      <div class="tagline">
        Cute • Cozy • Made With Love
      </div>

      <div class="coming-soon">
        Something cozy is coming 🍂
      </div>

      <p class="message">
        Our Fall & Halloween Collection is coming soon!
        We’re busy stitching up something special.
      </p>

      {% form 'storefront_password' %}

        {{ form.errors | default_errors }}

        <div class="password-form">

          <input
            type="password"
            name="password"
            placeholder="Enter password"
          >

          <button type="submit">
            Enter Shop
          </button>

        </div>

      {% endform %}

      <div class="footer-text">
        Handmade with love by Lil Stitch Studio ♡
      </div>

    </div>

  </main>

  {{ content_for_layout }}

</body>
</html>
