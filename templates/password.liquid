<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Lil Stitch Studio</title>

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&family=Caveat:wght@600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    .password-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 18px;
      position: relative;
      overflow: hidden;
    }

    .password-card {
      width: 100%;
      max-width: 560px;
      background: var(--cream-card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 44px 30px;
      text-align: center;
      box-shadow: 0 15px 45px rgba(69, 58, 44, 0.12);
      position: relative;
      z-index: 2;
    }

    .password-logo {
      width: 105px;
      margin: 0 auto 15px;
    }

    .password-logo img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    .password-title {
      margin: 0;
      font-family: "Caveat", cursive;
      font-size: clamp(46px, 9vw, 62px);
      color: var(--sage-dark);
      line-height: 1;
    }

    .password-tagline {
      margin-top: 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--rust-dark);
    }

    .password-coming {
      margin: 24px 0 8px;
      font-size: 28px;
    }

    .password-message {
      max-width: 410px;
      margin: 0 auto 26px;
      color: var(--text-mid);
      font-size: 15px;
      line-height: 1.7;
    }

    .password-form {
      display: flex;
      gap: 10px;
      max-width: 400px;
      margin: 0 auto;
    }

    .password-form input {
      flex: 1;
      min-width: 0;
      padding: 14px 18px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--white);
      outline: none;
    }

    .password-form input:focus {
      border-color: var(--sage);
    }

    .password-footer {
      margin-top: 24px;
      color: var(--text-mid);
      font-size: 12px;
    }

    .password-blob {
      position: absolute;
      border-radius: 50%;
      opacity: 0.45;
    }

    .password-blob.one {
      width: 260px;
      height: 260px;
      background: var(--sage-light);
      top: -110px;
      left: -90px;
    }

    .password-blob.two {
      width: 250px;
      height: 250px;
      background: var(--pink);
      right: -100px;
      bottom: -100px;
    }

    @media (max-width: 520px) {
      .password-card {
        padding: 36px 20px;
      }

      .password-form {
        flex-direction: column;
      }

      .password-form button {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <main class="password-page">

    <div class="password-blob one"></div>
    <div class="password-blob two"></div>

    <div class="password-card">

      <div class="password-logo">
        <!-- WE'LL PUT YOUR STORK IMAGE HERE -->
        🕊️
      </div>

      <h1 class="password-title">
        Lil Stitch Studio
      </h1>

      <div class="password-tagline">
        Cute · Cozy · Made With Love
      </div>

      <div class="stitch-divider"></div>

      <h2 class="password-coming">
        Something cozy is coming...
      </h2>

      <p class="password-message">
        Our Fall & Halloween Collection is coming soon! 🍂
        We’re busy stitching up something special and can’t wait
        to share it with you.
      </p>

      {% form 'storefront_password' %}

        {{ form.errors | default_errors }}

        <div class="password-form">

          <input
            type="password"
            name="password"
            placeholder="Enter shop password"
          >

          <button type="submit" class="btn btn-primary">
            Enter Shop
          </button>

        </div>

      {% endform %}

      <p class="password-footer">
        Handmade with ♡ by Lil Stitch Studio
      </p>

    </div>

  </main>

  {{ content_for_layout }}

</body>
</html>
