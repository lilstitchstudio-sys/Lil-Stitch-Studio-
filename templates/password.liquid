<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Lil Stitch Studio</title>

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&family=Caveat:wght@600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --sage: #8c9a72;
      --sage-dark: #66744c;
      --sage-light: #b7c09f;

      --cream: #fbf4e7;
      --cream-card: #fffcf6;

      --rust: #c1774b;
      --rust-dark: #9e5e38;

      --pink: #e4a9a1;
      --pink-dark: #ce8880;

      --text-dark: #453a2c;
      --text-mid: #6b5d4b;

      --white: #ffffff;
      --border: #e9dfc9;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
    }

    body {
      min-height: 100vh;
      background: var(--cream);
      color: var(--text-dark);
      font-family: "Quicksand", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .password-page {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 45px 20px;
    }

    .blob {
      position: absolute;
      border-radius: 50%;
      opacity: 0.45;
      pointer-events: none;
    }

    .blob-one {
      width: 280px;
      height: 280px;
      background: var(--sage-light);
      top: -120px;
      left: -100px;
    }

    .blob-two {
      width: 260px;
      height: 260px;
      background: var(--pink);
      bottom: -110px;
      right: -100px;
    }

    .blob-three {
      width: 130px;
      height: 130px;
      background: #edd0a7;
      top: 15%;
      right: 5%;
      opacity: 0.35;
    }

    .password-card {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 580px;
      padding: 48px 36px 38px;
      background: var(--cream-card);
      border: 1px solid var(--border);
      border-radius: 30px;
      box-shadow: 0 18px 50px rgba(69, 58, 44, 0.12);
      text-align: center;
    }

    .stork-wrap {
      margin: 0 auto 14px;
      width: 105px;
      height: 105px;
      border-radius: 50%;
      background: #f3ead9;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px dashed var(--sage-light);
    }

    .stork-placeholder {
      font-size: 48px;
      line-height: 1;
    }

    .brand-name {
      margin: 0;
      font-family: "Caveat", cursive;
      font-size: clamp(46px, 8vw, 62px);
      line-height: 0.95;
      color: var(--sage-dark);
      font-weight: 700;
    }

    .tagline {
      margin-top: 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--rust-dark);
    }

    .stitch-divider {
      width: 92px;
      height: 4px;
      margin: 22px auto;
      border-radius: 100px;
      background: repeating-linear-gradient(
        90deg,
        var(--rust) 0,
        var(--rust) 8px,
        transparent 8px,
        transparent 16px
      );
    }

    .coming-soon {
      margin: 0 0 10px;
      font-family: "Baloo 2", sans-serif;
      font-size: clamp(25px, 5vw, 33px);
      color: var(--text-dark);
      line-height: 1.15;
    }

    .message {
      max-width: 430px;
      margin: 0 auto 26px;
      color: var(--text-mid);
      font-size: 15px;
      line-height: 1.7;
    }

    .password-label {
      display: block;
      margin-bottom: 9px;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-mid);
    }

    .password-form {
      display: flex;
      gap: 10px;
      max-width: 410px;
      margin: 0 auto;
    }

    .password-form input {
      flex: 1;
      min-width: 0;
      padding: 14px 18px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--white);
      color: var(--text-dark);
      font-family: "Quicksand", sans-serif;
      font-size: 14px;
      outline: none;
    }

    .password-form input:focus {
      border-color: var(--sage);
      box-shadow: 0 0 0 3px rgba(140, 154, 114, 0.13);
    }

    .password-form button {
      border: 0;
      border-radius: 999px;
      padding: 14px 24px;
      background: var(--sage);
      color: var(--white);
      font-family: "Quicksand", sans-serif;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s ease;
      white-space: nowrap;
    }

    .password-form button:hover {
      background: var(--sage-dark);
      transform: translateY(-1px);
    }

    .errors {
      margin: 0 auto 15px;
      color: #a55353;
      font-size: 13px;
    }

    .tiny-note {
      margin-top: 24px;
      font-size: 12px;
      color: var(--text-mid);
    }

    .tiny-heart {
      color: var(--pink-dark);
    }

    .owner-link {
      margin-top: 18px;
      font-size: 11px;
    }

    .owner-link a {
      color: var(--rust-dark);
      text-decoration: none;
      font-weight: 700;
    }

    .owner-link a:hover {
      text-decoration: underline;
    }

    @media (max-width: 560px) {
      .password-page {
        padding: 25px 16px;
      }

      .password-card {
        padding: 38px 20px 30px;
        border-radius: 25px;
      }

      .stork-wrap {
        width: 90px;
        height: 90px;
      }

      .stork-placeholder {
        font-size: 42px;
      }

      .password-form {
        flex-direction: column;
      }

      .password-form button {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <main class="password-page">

    <div class="blob blob-one"></div>
    <div class="blob blob-two"></div>
    <div class="blob blob-three"></div>

    <section class="password-card">

      <div class="stork-wrap">
        <div class="stork-placeholder">🪡</div>
      </div>

      <h1 class="brand-name">
        Lil Stitch Studio
      </h1>

      <div class="tagline">
        Cute · Cozy · Made With Love
      </div>

      <div class="stitch-divider"></div>

      <h2 class="coming-soon">
        Something cozy is coming...
      </h2>

      <p class="message">
        Our Fall & Halloween Collection is coming soon! 🍂
        We’re busy stitching up something special and can’t wait
        to share it with you.
      </p>

      {% form 'storefront_password' %}

        {{ form.errors | default_errors }}

        <label class="password-label" for="Password">
          Have the shop password?
        </label>

        <div class="password-form">

          <input
            id="Password"
            type="password"
            name="password"
            placeholder="Enter password"
            autocomplete="current-password"
          >

          <button type="submit">
            Enter Shop
          </button>

        </div>

      {% endform %}

      <p class="tiny-note">
        Handmade with <span class="tiny-heart">♥</span> by Lil Stitch Studio
      </p>

      <p class="owner-link">
        Store owner?
        <a href="/admin">
          Log in here
        </a>
      </p>

    </section>

  </main>

  {{ content_for_layout }}

</body>
</html>
