<section class="lss-product-page">

  <div class="lss-product-wrap">

    <!-- PRODUCT PHOTOS -->
    <div class="lss-product-gallery">

      {% if product.featured_media %}
        <div class="lss-main-image">
          {{
            product.featured_media
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              alt: product.title
          }}
        </div>
      {% else %}
        <div class="lss-main-image lss-no-image">
          ♡
        </div>
      {% endif %}


      {% if product.media.size > 1 %}
        <div class="lss-thumbnails">

          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <button
                type="button"
                class="lss-thumbnail {% if forloop.first %}active{% endif %}"
                data-image="{{ media | image_url: width: 1200 }}"
              >
                {{
                  media
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    alt: product.title
                }}
              </button>
            {% endif %}
          {% endfor %}

        </div>
      {% endif %}

    </div>


    <!-- PRODUCT DETAILS -->
    <div class="lss-product-details">

      <span class="lss-product-eyebrow">
        ♡ HANDMADE WITH LOVE ♡
      </span>

      <h1>{{ product.title }}</h1>

      <div class="lss-product-price" id="LSSProductPrice">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>


      {% if product.description != blank %}
        <div class="lss-product-description">
          {{ product.description }}
        </div>
      {% endif %}


      {% form 'product', product, id: 'LSSProductForm' %}

        <input
          type="hidden"
          name="id"
          id="LSSVariantId"
          value="{{ product.selected_or_first_available_variant.id }}"
        >


        <!-- OPTIONS / SIZES -->
        {% unless product.has_only_default_variant %}

          {% for option in product.options_with_values %}

            <div
              class="lss-option-group"
              data-option-index="{{ forloop.index0 }}"
            >

              <div class="lss-option-heading">
                <label>
                  Choose {{ option.name }}
                </label>

                {% if option.name contains 'Size' %}
                  <span>♡</span>
                {% endif %}
              </div>


              <div class="lss-option-buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="lss-option-button
                    {% if option.selected_value == value %} selected{% endif %}"
                    data-value="{{ value | escape }}"
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            </div>

          {% endfor %}

        {% endunless %}


        <!-- QUANTITY -->
        <div class="lss-product-quantity-wrap">

          <label>Quantity</label>

          <div class="lss-product-quantity">

            <button
              type="button"
              id="LSSQtyMinus"
              aria-label="Decrease quantity"
            >
              −
            </button>

            <input
              type="number"
              name="quantity"
              id="LSSQty"
              value="1"
              min="1"
            >

            <button
              type="button"
              id="LSSQtyPlus"
              aria-label="Increase quantity"
            >
              +
            </button>

          </div>

        </div>


        <!-- ADD TO BAG -->
        <button
          type="submit"
          name="add"
          id="LSSAddToBag"
          class="lss-add-to-bag"
          {% unless product.selected_or_first_available_variant.available %}
            disabled
          {% endunless %}
        >

          {% if product.selected_or_first_available_variant.available %}
            Add to Bag
            <span>♡</span>
          {% else %}
            Sold Out
          {% endif %}

        </button>


        <p class="lss-product-note">
          ♡ Handmade just for your little one
        </p>

      {% endform %}


      <div class="lss-product-details-box">

        <div>
          <span>♡</span>
          <p>
            <strong>Handmade with care</strong><br>
            Made especially for your little ones.
          </p>
        </div>

        <div>
          <span>♡</span>
          <p>
            <strong>Secure checkout</strong><br>
            Checkout safely through Shopify.
          </p>
        </div>

      </div>


      <a
        href="{{ routes.all_products_collection_url }}"
        class="lss-product-back"
      >
        ← Keep Shopping
      </a>

    </div>

  </div>

</section>


<script>
document.addEventListener('DOMContentLoaded', function () {

  const productData = {{ product.variants | json }};

  const optionGroups = document.querySelectorAll('.lss-option-group');
  const variantInput = document.getElementById('LSSVariantId');
  const price = document.getElementById('LSSProductPrice');
  const addButton = document.getElementById('LSSAddToBag');

  function getSelectedOptions() {

    const selections = [];

    optionGroups.forEach(function(group) {

      const selected = group.querySelector('.lss-option-button.selected');

      if (selected) {
        selections.push(selected.dataset.value);
      }

    });

    return selections;
  }


  function updateVariant() {

    const selectedOptions = getSelectedOptions();

    const matchingVariant = productData.find(function(variant) {

      return variant.options.every(function(option, index) {
        return option === selectedOptions[index];
      });

    });


    if (!matchingVariant) {
      addButton.disabled = true;
      addButton.innerHTML = 'Unavailable';
      return;
    }


    variantInput.value = matchingVariant.id;


    const money = new Intl.NumberFormat(
      '{{ localization.country.iso_code | default: "CA" }}' === 'CA'
        ? 'en-CA'
        : 'en-US',
      {
        style: 'currency',
        currency: '{{ cart.currency.iso_code | default: shop.currency }}'
      }
    ).format(matchingVariant.price / 100);

    price.textContent = money;


    if (matchingVariant.available) {

      addButton.disabled = false;
      addButton.innerHTML = 'Add to Bag <span>♡</span>';

    } else {

      addButton.disabled = true;
      addButton.innerHTML = 'Sold Out';

    }


    if (history.replaceState) {

      const url = new URL(window.location.href);

      url.searchParams.set('variant', matchingVariant.id);

      history.replaceState({}, '', url);

    }

  }


  optionGroups.forEach(function(group) {

    const buttons = group.querySelectorAll('.lss-option-button');

    buttons.forEach(function(button) {

      button.addEventListener('click', function() {

        buttons.forEach(function(otherButton) {
          otherButton.classList.remove('selected');
        });

        button.classList.add('selected');

        updateVariant();

      });

    });

  });


  // QUANTITY

  const qtyInput = document.getElementById('LSSQty');
  const qtyMinus = document.getElementById('LSSQtyMinus');
  const qtyPlus = document.getElementById('LSSQtyPlus');

  qtyMinus.addEventListener('click', function() {

    let qty = parseInt(qtyInput.value, 10) || 1;

    if (qty > 1) {
      qtyInput.value = qty - 1;
    }

  });


  qtyPlus.addEventListener('click', function() {

    let qty = parseInt(qtyInput.value, 10) || 1;

    qtyInput.value = qty + 1;

  });


  // IMAGE THUMBNAILS

  const mainImage = document.querySelector('.lss-main-image img');
  const thumbnails = document.querySelectorAll('.lss-thumbnail');

  thumbnails.forEach(function(thumbnail) {

    thumbnail.addEventListener('click', function() {

      thumbnails.forEach(function(otherThumbnail) {
        otherThumbnail.classList.remove('active');
      });

      thumbnail.classList.add('active');

      if (mainImage) {
        mainImage.src = thumbnail.dataset.image;
      }

    });

  });

});
</script>


<style>

.lss-product-page {
  min-height: 100vh;
  padding: 70px 20px 100px;

  background:
    radial-gradient(circle at 5% 20%, rgba(231, 196, 196, 0.22), transparent 28%),
    radial-gradient(circle at 95% 80%, rgba(226, 202, 193, 0.22), transparent 30%),
    #fbf7f1;

  color: #5c4c47;
}


.lss-product-wrap {
  width: min(1150px, 100%);
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 70px;
  align-items: start;
}


/* IMAGES */

.lss-main-image {
  overflow: hidden;

  width: 100%;
  aspect-ratio: 1 / 1.05;

  border-radius: 32px;

  background: #f2e7df;

  box-shadow:
    0 18px 55px rgba(92, 68, 62, 0.09);
}


.lss-main-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}


.lss-no-image {
  display: flex;
  align-items: center;
  justify-content: center;

  color: #ce9797;
  font-size: 70px;
}


.lss-thumbnails {
  margin-top: 15px;

  display: flex;
  gap: 12px;

  overflow-x: auto;
  padding-bottom: 4px;
}


.lss-thumbnail {
  flex: 0 0 82px;

  width: 82px;
  height: 82px;

  padding: 0;

  overflow: hidden;

  border: 2px solid transparent;
  border-radius: 16px;

  background: #f5ebe5;

  cursor: pointer;
}


.lss-thumbnail.active {
  border-color: #c78d8f;
}


.lss-thumbnail img {
  width: 100%;
  height: 100%;

  display: block;
  object-fit: cover;
}



/* DETAILS */

.lss-product-details {
  padding-top: 14px;
}


.lss-product-eyebrow {
  display: block;

  margin-bottom: 8px;

  color: #b17f80;

  font-family: 'Quicksand', sans-serif;
  font-size: 11px;
  font-weight: 800;

  letter-spacing: 2px;
}


.lss-product-details h1 {
  margin: 0;

  color: #67514b;

  font-family: 'Baloo 2', sans-serif;
  font-size: clamp(38px, 5vw, 55px);
  line-height: 1.05;
}


.lss-product-price {
  margin-top: 10px;

  color: #a76e71;

  font-family: 'Baloo 2', sans-serif;
  font-size: 25px;
  font-weight: 700;
}


.lss-product-description {
  margin: 25px 0 30px;

  color: #796964;

  font-family: 'Quicksand', sans-serif;
  font-size: 14px;
  line-height: 1.8;
}


.lss-product-description p {
  margin-top: 0;
}


/* OPTION BUTTONS */

.lss-option-group {
  margin-top: 27px;
}


.lss-option-heading {
  margin-bottom: 12px;

  display: flex;
  align-items: center;
  gap: 7px;

  color: #66534e;

  font-family: 'Quicksand', sans-serif;
  font-size: 13px;
  font-weight: 800;
}


.lss-option-heading span {
  color: #c89091;
}


.lss-option-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}


.lss-option-button {
  min-width: 54px;

  padding: 11px 16px;

  border: 1px solid #dfcbc3;
  border-radius: 999px;

  background: #fffdfa;

  color: #75615c;

  font-family: 'Quicksand', sans-serif;
  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    border-color .2s ease,
    transform .2s ease;
}


.lss-option-button:hover {
  transform: translateY(-1px);

  border-color: #c89191;
}


.lss-option-button.selected {
  border-color: #c68b8e;

  background: #c98d90;

  color: #fff;
}



/* QUANTITY */

.lss-product-quantity-wrap {
  margin-top: 28px;
}


.lss-product-quantity-wrap > label {
  display: block;

  margin-bottom: 11px;

  color: #66534e;

  font-family: 'Quicksand', sans-serif;
  font-size: 13px;
  font-weight: 800;
}


.lss-product-quantity {
  width: 125px;
  height: 45px;

  display: flex;
  align-items: center;

  overflow: hidden;

  border: 1px solid #dccac3;
  border-radius: 999px;

  background: #fffdfa;
}


.lss-product-quantity button {
  width: 42px;
  height: 100%;

  padding: 0;

  border: 0;

  background: transparent;

  color: #94736e;

  font-size: 20px;

  cursor: pointer;
}


.lss-product-quantity input {
  width: 41px;

  padding: 0;

  border: 0;
  outline: none;

  background: transparent;

  color: #66524d;

  font-family: 'Quicksand', sans-serif;
  font-weight: 800;

  text-align: center;

  -moz-appearance: textfield;
}


.lss-product-quantity input::-webkit-inner-spin-button,
.lss-product-quantity input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}



/* ADD TO BAG */

.lss-add-to-bag {
  width: 100%;
  min-height: 58px;

  margin-top: 28px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  border: 0;
  border-radius: 999px;

  background: #c8898d;

  color: white;

  font-family: 'Quicksand', sans-serif;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: .4px;

  cursor: pointer;

  box-shadow:
    0 9px 23px rgba(172, 108, 112, 0.22);

  transition:
    transform .2s ease,
    background .2s ease;
}


.lss-add-to-bag:hover:not(:disabled) {
  transform: translateY(-2px);

  background: #bd7c80;
}


.lss-add-to-bag:disabled {
  background: #cbbdba;

  cursor: not-allowed;

  box-shadow: none;
}


.lss-product-note {
  margin: 12px 0 0;

  color: #aa8985;

  font-family: 'Quicksand', sans-serif;
  font-size: 11px;

  text-align: center;
}



/* INFO BOX */

.lss-product-details-box {
  margin-top: 34px;
  padding: 20px;

  display: grid;
  gap: 16px;

  border: 1px solid #e7d7cf;
  border-radius: 20px;

  background: rgba(255,255,255,.55);
}


.lss-product-details-box > div {
  display: flex;
  gap: 13px;
  align-items: flex-start;
}


.lss-product-details-box span {
  color: #c78c8e;
  font-size: 18px;
}


.lss-product-details-box p {
  margin: 0;

  color: #887570;

  font-family: 'Quicksand', sans-serif;
  font-size: 11px;
  line-height: 1.55;
}


.lss-product-details-box strong {
  color: #67544e;
  font-size: 12px;
}


.lss-product-back {
  display: inline-block;

  margin-top: 25px;

  color: #97746f;

  font-family: 'Quicksand', sans-serif;
  font-size: 12px;
  font-weight: 700;

  text-decoration: none;
}



/* MOBILE */

@media (max-width: 800px) {

  .lss-product-page {
    padding: 35px 14px 70px;
  }


  .lss-product-wrap {
    grid-template-columns: 1fr;
    gap: 35px;
  }


  .lss-main-image {
    border-radius: 24px;
  }


  .lss-product-details {
    padding: 0 5px;
  }


  .lss-product-details h1 {
    font-size: 39px;
  }


  .lss-add-to-bag {
    position: relative;
  }

}


@media (max-width: 480px) {

  .lss-thumbnail {
    flex-basis: 70px;

    width: 70px;
    height: 70px;

    border-radius: 13px;
  }


  .lss-option-button {
    padding: 10px 14px;

    font-size: 11px;
  }

}

</style>


{% schema %}
{
  "name": "Lil Stitch Product",
  "settings": []
}
{% endschema %}
