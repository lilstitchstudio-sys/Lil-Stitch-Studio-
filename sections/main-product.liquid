<section class="lss-product-page">

  <div class="lss-product-wrap">

    <!-- PRODUCT PHOTOS -->
    <div class="lss-product-gallery">

      {% if product.featured_media %}
        <div class="lss-main-image">
          {{
            product.featured_media
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              alt: product.title
          }}
        </div>
      {% else %}
        <div class="lss-main-image lss-no-image">
          ♡
        </div>
      {% endif %}


      {% if product.media.size > 1 %}
        <div class="lss-thumbnails">

          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <button
                type="button"
                class="lss-thumbnail {% if forloop.first %}active{% endif %}"
                data-image="{{ media | image_url: width: 1200 }}"
              >
                {{
                  media
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    alt: product.title
                }}
              </button>
            {% endif %}
          {% endfor %}

        </div>
      {% endif %}

    </div>


    <!-- PRODUCT DETAILS -->
    <div class="lss-product-details">

      <span class="lss-product-eyebrow">
        ♡ HANDMADE WITH LOVE ♡
      </span>

      <h1>{{ product.title }}</h1>

      <div class="lss-product-price" id="LSSProductPrice">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>


      {% if product.description != blank %}
        <div class="lss-product-description">
          {{ product.description }}
        </div>
      {% endif %}


      {% form 'product', product, id: 'LSSProductForm' %}

        <input
          type="hidden"
          name="id"
          id="LSSVariantId"
          value="{{ product.selected_or_first_available_variant.id }}"
        >


        <!-- OPTIONS / SIZES -->
        {% unless product.has_only_default_variant %}

          {% for option in product.options_with_values %}

            <div
              class="lss-option-group"
              data-option-index="{{ forloop.index0 }}"
            >

              <div class="lss-option-heading">
                <label>
                  Choose {{ option.name }}
                </label>

                {% if option.name contains 'Size' %}
                  <span>♡</span>
                {% endif %}
              </div>


              <div class="lss-option-buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="lss-option-button
                    {% if option.selected_value == value %} selected{% endif %}"
                    data-value="{{ value | escape }}"
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            </div>

          {% endfor %}

        {% endunless %}


        <!-- QUANTITY -->
        <div class="lss-product-quantity-wrap">

          <label>Quantity</label>

          <div class="lss-product-quantity">

            <button
              type="button"
              id="LSSQtyMinus"
              aria-label="Decrease quantity"
            >
              −
            </button>

            <input
              type="number"
              name="quantity"
              id="LSSQty"
              value="1"
              min="1"
            >

            <button
              type="button"
              id="LSSQtyPlus"
              aria-label="Increase quantity"
            >
              +
            </button>

          </div>

        </div>


        <!-- ADD TO BAG -->
        <button
          type="submit"
          name="add"
          id="LSSAddToBag"
          class="lss-add-to-bag"
          {% unless product.selected_or_first_available_variant.available %}
            disabled
          {% endunless %}
        >

          {% if product.selected_or_first_available_variant.available %}
            Add to Bag
            <span>♡</span>
          {% else %}
            Sold Out
          {% endif %}

        </button>


        <p class="lss-product-note">
          ♡ Handmade just for your little one
        </p>

      {% endform %}


      <div class="lss-product-details-box">

        <div>
          <span>♡</span>
          <p>
            <strong>Handmade with care</strong><br>
            Made especially for your little ones.
          </p>
        </div>

        <div>
          <span>♡</span>
          <p>
            <strong>Secure checkout</strong><br>
            Checkout safely through Shopify.
          </p>
        </div>

      </div>


      <a
        href="{{ routes.all_products_collection_url }}"
        class="lss-product-back"
      >
        ← Keep Shopping
      </a>

    </div>

  </div>

</section>


<script>
document.addEventListener('DOMContentLoaded', function () {
  const productData = {{ product.variants | json }};

  // Inventory must be added explicitly; it isn't included in variant JSON.
  const inventory = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        tracked: {% if variant.inventory_management != blank %}true{% else %}false{% endif %},
        policy: {{ variant.inventory_policy | json }},
        quantity: {{ variant.inventory_quantity | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  const form = document.getElementById('LSSProductForm');
  const optionGroups = document.querySelectorAll('.lss-option-group');
  const variantInput = document.getElementById('LSSVariantId');
  const price = document.getElementById('LSSProductPrice');
  const addButton = document.getElementById('LSSAddToBag');
  const qtyInput = document.getElementById('LSSQty');
  const qtyMinus = document.getElementById('LSSQtyMinus');
  const qtyPlus = document.getElementById('LSSQtyPlus');
  const root = window.Shopify?.routes?.root || '/';

  let cartItems = [];
  let busy = false;
  let cartReady = false;

  const message = document.createElement('p');
  message.setAttribute('role', 'status');
  message.setAttribute('aria-live', 'polite');
  message.style.cssText =
    'color:#796964;font-size:13px;margin:12px 0;';
  addButton.before(message);

  function selectedVariant() {
    return productData.find(function (variant) {
      return String(variant.id) === variantInput.value;
    });
  }

  function remainingStock(variant) {
    if (!variant || !variant.available) return 0;

    const stock = inventory[String(variant.id)];

    if (!stock.tracked || stock.policy === 'continue') {
      return Infinity;
    }

    const inBag = cartItems.reduce(function (total, item) {
      return String(item.variant_id) === String(variant.id)
        ? total + item.quantity
        : total;
    }, 0);

    return Math.max(0, stock.quantity - inBag);
  }

  function updateControls() {
    const variant = selectedVariant();
    const remaining = remainingStock(variant);

    let quantity = Math.max(
      1, Math.floor(Number(qtyInput.value) || 1)
    );

    if (Number.isFinite(remaining)) {
      qtyInput.max = String(remaining);
      quantity = Math.min(quantity, Math.max(1, remaining));
    } else {
      qtyInput.removeAttribute('max');
    }

    qtyInput.value = quantity;
    qtyInput.disabled = busy || !cartReady || remaining === 0;
    qtyMinus.disabled = qtyInput.disabled || quantity <= 1;
    qtyPlus.disabled = qtyInput.disabled || quantity >= remaining;

    [qtyMinus, qtyPlus].forEach(function (button) {
      button.style.opacity = button.disabled ? '0.35' : '1';
      button.style.cursor = button.disabled
        ? 'not-allowed'
        : 'pointer';
    });

    addButton.disabled = busy || !cartReady || remaining === 0;

    if (busy) {
      addButton.textContent = 'Adding…';
    } else if (!cartReady) {
      addButton.textContent = 'Check availability';
    } else if (!variant) {
      addButton.textContent = 'Unavailable';
    } else if (!variant.available) {
      addButton.textContent = 'Sold Out';
    } else if (remaining === 0) {
      addButton.textContent = 'All available stock is in your bag';
    } else {
      addButton.innerHTML = 'Add to Bag <span>♡</span>';
    }

    if (!variant || !variant.available) {
      message.textContent = '';
    } else if (remaining === 0) {
      message.textContent =
        'All available stock for this option is already in your bag.';
    } else if (Number.isFinite(remaining)) {
      message.textContent =
        'You can add ' + remaining + ' more of this option.';
    } else {
      message.textContent = '';
    }
  }

  async function refreshCart() {
    const response = await fetch(root + 'cart.js', {
      cache: 'no-store',
      headers: { Accept: 'application/json' }
    });

    if (!response.ok) {
      throw new Error('Unable to check your bag. Please refresh and try again.');
    }

    const cart = await response.json();
    cartItems = cart.items;
    cartReady = true;
  }

  function updateVariant() {
    const selections = Array.from(optionGroups).map(function (group) {
      return group.querySelector('.lss-option-button.selected')
        ?.dataset.value;
    });

    const variant = productData.find(function (item) {
      return item.options.every(function (option, index) {
        return option === selections[index];
      });
    });

    variantInput.value = variant ? variant.id : '';

    if (variant) {
      price.textContent = new Intl.NumberFormat(
        document.documentElement.lang || 'en-CA',
        {
          style: 'currency',
          currency: {{ cart.currency.iso_code | default: shop.currency | json }}
        }
      ).format(variant.price / 100);

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url);
    }

    updateControls();
  }

  optionGroups.forEach(function (group) {
    group.querySelectorAll('.lss-option-button').forEach(function (button) {
      button.addEventListener('click', function () {
        group.querySelectorAll('.lss-option-button').forEach(function (other) {
          other.classList.remove('selected');
        });

        button.classList.add('selected');
        updateVariant();
      });
    });
  });

  qtyMinus.addEventListener('click', function () {
    qtyInput.value = Math.max(1, Number(qtyInput.value) - 1);
    updateControls();
  });

  qtyPlus.addEventListener('click', function () {
    qtyInput.value = Number(qtyInput.value) + 1;
    updateControls();
  });

  qtyInput.addEventListener('input', updateControls);
  qtyInput.addEventListener('change', updateControls);

  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    event.stopImmediatePropagation();

    if (busy) return;

    const variant = selectedVariant();
    if (!variant || !variant.available) return;

    const requested = Math.max(
      1, Math.floor(Number(qtyInput.value) || 1)
    );
    const formData = new FormData(form);

    busy = true;
    updateControls();

    let errorMessage = '';

    try {
      await refreshCart();

      const remaining = remainingStock(variant);

      if (requested > remaining) {
        errorMessage = remaining === 0
          ? 'All available stock for this option is already in your bag.'
          : 'Only ' + remaining + ' more available. Please check the quantity.';
      } else {
        formData.set('id', String(variant.id));
        formData.set('quantity', String(requested));

        const response = await fetch(root + 'cart/add.js', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        });

        const result = await response.json();

        if (!response.ok) {
          errorMessage = result.description ||
            result.message ||
            'Unable to add this quantity. Please try again.';

          await refreshCart();
        } else {
          window.location.assign(root + 'cart');
          return;
        }
      }
    } catch (error) {
      errorMessage =
        'Unable to confirm your bag. Please refresh before trying again.';
    }

    busy = false;
    updateControls();
    if (errorMessage) message.textContent = errorMessage;
  }, true);

  // Keep the existing thumbnail gallery working.
  const mainImage = document.querySelector('.lss-main-image img');
  const thumbnails = document.querySelectorAll('.lss-thumbnail');

  thumbnails.forEach(function (thumbnail) {
    thumbnail.addEventListener('click', function () {
      thumbnails.forEach(function (other) {
        other.classList.remove('active');
      });

      thumbnail.classList.add('active');

      if (mainImage) {
        mainImage.removeAttribute('srcset');
        mainImage.src = thumbnail.dataset.image;
      }
    });
  });

  async function syncCart() {
    if (busy) return;

    try {
      await refreshCart();
      updateControls();
    } catch (error) {
      cartReady = false;
      updateControls();
      message.textContent = error.message;
    }
  }

  updateControls();
  syncCart();

  window.addEventListener('focus', syncCart);
  window.addEventListener('pageshow', function (event) {
    if (event.persisted) syncCart();
  });
});
</script>


<style>

.lss-product-page {
  min-height: 100vh;
  padding: 70px 20px 100px;

  background:
    radial-gradient(circle at 5% 20%, rgba(231, 196, 196, 0.22), transparent 28%),
    radial-gradient(circle at 95% 80%, rgba(226, 202, 193, 0.22), transparent 30%),
    #fbf7f1;

  color: #5c4c47;
}


.lss-product-wrap {
  width: min(1150px, 100%);
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 70px;
  align-items: start;
}


/* IMAGES */

.lss-main-image {
  overflow: hidden;

  width: 100%;
  aspect-ratio: 1 / 1.05;

  border-radius: 32px;

  background: #f2e7df;

  box-shadow:
    0 18px 55px rgba(92, 68, 62, 0.09);
}


.lss-main-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}


.lss-no-image {
  display: flex;
  align-items: center;
  justify-content: center;

  color: #ce9797;
  font-size: 70px;
}


.lss-thumbnails {
  margin-top: 15px;

  display: flex;
  gap: 12px;

  overflow-x: auto;
  padding-bottom: 4px;
}


.lss-thumbnail {
  flex: 0 0 82px;

  width: 82px;
  height: 82px;

  padding: 0;

  overflow: hidden;

  border: 2px solid transparent;
  border-radius: 16px;

  background: #f5ebe5;

  cursor: pointer;
}


.lss-thumbnail.active {
  border-color: #c78d8f;
}


.lss-thumbnail img {
  width: 100%;
  height: 100%;

  display: block;
  object-fit: cover;
}



/* DETAILS */

.lss-product-details {
  padding-top: 14px;
}


.lss-product-eyebrow {
  display: block;

  margin-bottom: 8px;

  color: #b17f80;

  font-family: 'Quicksand', sans-serif;
  font-size: 11px;
  font-weight: 800;

  letter-spacing: 2px;
}


.lss-product-details h1 {
  margin: 0;

  color: #67514b;

  font-family: 'Baloo 2', sans-serif;
  font-size: clamp(38px, 5vw, 55px);
  line-height: 1.05;
}


.lss-product-price {
  margin-top: 10px;

  color: #a76e71;

  font-family: 'Baloo 2', sans-serif;
  font-size: 25px;
  font-weight: 700;
}


.lss-product-description {
  margin: 25px 0 30px;

  color: #796964;

  font-family: 'Quicksand', sans-serif;
  font-size: 14px;
  line-height: 1.8;
}


.lss-product-description p {
  margin-top: 0;
}


/* OPTION BUTTONS */

.lss-option-group {
  margin-top: 27px;
}


.lss-option-heading {
  margin-bottom: 12px;

  display: flex;
  align-items: center;
  gap: 7px;

  color: #66534e;

  font-family: 'Quicksand', sans-serif;
  font-size: 13px;
  font-weight: 800;
}


.lss-option-heading span {
  color: #c89091;
}


.lss-option-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}


.lss-option-button {
  min-width: 54px;

  padding: 11px 16px;

  border: 1px solid #dfcbc3;
  border-radius: 999px;

  background: #fffdfa;

  color: #75615c;

  font-family: 'Quicksand', sans-serif;
  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    border-color .2s ease,
    transform .2s ease;
}


.lss-option-button:hover {
  transform: translateY(-1px);

  border-color: #c89191;
}


.lss-option-button.selected {
  border-color: #c68b8e;

  background: #c98d90;

  color: #fff;
}



/* QUANTITY */

.lss-product-quantity-wrap {
  margin-top: 28px;
}


.lss-product-quantity-wrap > label {
  display: block;

  margin-bottom: 11px;

  color: #66534e;

  font-family: 'Quicksand', sans-serif;
  font-size: 13px;
  font-weight: 800;
}


.lss-product-quantity {
  width: 125px;
  height: 45px;

  display: flex;
  align-items: center;

  overflow: hidden;

  border: 1px solid #dccac3;
  border-radius: 999px;

  background: #fffdfa;
}


.lss-product-quantity button {
  width: 42px;
  height: 100%;

  padding: 0;

  border: 0;

  background: transparent;

  color: #94736e;

  font-size: 20px;

  cursor: pointer;
}


.lss-product-quantity input {
  width: 41px;

  padding: 0;

  border: 0;
  outline: none;

  background: transparent;

  color: #66524d;

  font-family: 'Quicksand', sans-serif;
  font-weight: 800;

  text-align: center;

  -moz-appearance: textfield;
}


.lss-product-quantity input::-webkit-inner-spin-button,
.lss-product-quantity input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}



/* ADD TO BAG */

.lss-add-to-bag {
  width: 100%;
  min-height: 58px;

  margin-top: 28px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  border: 0;
  border-radius: 999px;

  background: #c8898d;

  color: white;

  font-family: 'Quicksand', sans-serif;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: .4px;

  cursor: pointer;

  box-shadow:
    0 9px 23px rgba(172, 108, 112, 0.22);

  transition:
    transform .2s ease,
    background .2s ease;
}


.lss-add-to-bag:hover:not(:disabled) {
  transform: translateY(-2px);

  background: #bd7c80;
}


.lss-add-to-bag:disabled {
  background: #cbbdba;

  cursor: not-allowed;

  box-shadow: none;
}


.lss-product-note {
  margin: 12px 0 0;

  color: #aa8985;

  font-family: 'Quicksand', sans-serif;
  font-size: 11px;

  text-align: center;
}



/* INFO BOX */

.lss-product-details-box {
  margin-top: 34px;
  padding: 20px;

  display: grid;
  gap: 16px;

  border: 1px solid #e7d7cf;
  border-radius: 20px;

  background: rgba(255,255,255,.55);
}


.lss-product-details-box > div {
  display: flex;
  gap: 13px;
  align-items: flex-start;
}


.lss-product-details-box span {
  color: #c78c8e;
  font-size: 18px;
}


.lss-product-details-box p {
  margin: 0;

  color: #887570;

  font-family: 'Quicksand', sans-serif;
  font-size: 11px;
  line-height: 1.55;
}


.lss-product-details-box strong {
  color: #67544e;
  font-size: 12px;
}


.lss-product-back {
  display: inline-block;

  margin-top: 25px;

  color: #97746f;

  font-family: 'Quicksand', sans-serif;
  font-size: 12px;
  font-weight: 700;

  text-decoration: none;
}



/* MOBILE */

@media (max-width: 800px) {

  .lss-product-page {
    padding: 35px 14px 70px;
  }


  .lss-product-wrap {
    grid-template-columns: 1fr;
    gap: 35px;
  }


  .lss-main-image {
    border-radius: 24px;
  }


  .lss-product-details {
    padding: 0 5px;
  }


  .lss-product-details h1 {
    font-size: 39px;
  }


  .lss-add-to-bag {
    position: relative;
  }

}


@media (max-width: 480px) {

  .lss-thumbnail {
    flex-basis: 70px;

    width: 70px;
    height: 70px;

    border-radius: 13px;
  }


  .lss-option-button {
    padding: 10px 14px;

    font-size: 11px;
  }

}

</style>


{% schema %}
{
  "name": "Lil Stitch Product",
  "settings": []
}
{% endschema %}
