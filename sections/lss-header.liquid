<div class="announcement-bar">
  <p>{{ section.settings.announcement_text }}</p>
</div>

<header class="site-header">
  <div class="container header-inner">

    <a href="{{ routes.root_url }}" class="logo">
      {% if section.settings.header_logo != blank %}
        <img
          src="{{ section.settings.header_logo | image_url: width: 500 }}"
          alt="{{ shop.name | escape }}"
          style="
            display:block;
            width:180px;
            max-width:100%;
            height:auto;
            object-fit:contain;
          "
        >
      {% else %}
        <span class="logo-script">{{ section.settings.logo_main }}</span>
        <span class="logo-sub">{{ section.settings.logo_sub }}</span>
      {% endif %}
    </a>

    <button
      class="mobile-menu-btn"
      id="menuBtn-{{ section.id }}"
      aria-label="Toggle menu"
      aria-expanded="false"
      type="button"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <nav class="main-nav" id="mainNav-{{ section.id }}">

  <a href="{{ routes.root_url }}">
    Home
  </a>

  <a
    class="menu-shop-all"
    href="{{ routes.all_products_collection_url }}"
  >
    Shop All
  </a>

  <a
    class="menu-collection-link"
    href="/collections/little-ones"
  >
    Little Ones
  </a>

  <a
    class="menu-collection-link"
    href="/collections/for-mama"
  >
    For Mama
  </a>

  <a
    class="menu-collection-link"
    href="/collections/made-just-for-you"
  >
    Made Just for You
  </a>

  <div class="seasonal-dropdown">

  <button
    type="button"
    class="seasonal-toggle"
    onclick="this.parentElement.classList.toggle('seasonal-open')"
  >
    <span>Seasonal Favourites</span>
    <span class="seasonal-chevron">⌄</span>
  </button>

  <div class="seasonal-links">

    <a
      class="seasonal-child-link"
      href="/collections/fall-halloween"
    >
      Fall + Halloween
    </a>

    <a
      class="seasonal-child-link"
      href="/collections/christmas"
    >
      Christmas
    </a>

  </div>
</div>

<style>
  .seasonal-dropdown {
    width: 100%;
  }

  .seasonal-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;

    padding: 13px 16px;
    margin: 6px 0;

    background: #efd4d1 !important;
    color: #5b514b !important;

    border: none !important;
    border-radius: 14px;

    font-family: "Quicksand", sans-serif !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    line-height: 1.6;

    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
  }

  .seasonal-chevron {
    font-family: "Quicksand", sans-serif !important;
    font-size: 16px;
    transition: transform 0.2s ease;
  }

  .seasonal-links {
    display: none;
    padding-left: 14px;
  }

  .seasonal-open .seasonal-links {
    display: block;
  }

  .seasonal-open .seasonal-chevron {
    transform: rotate(180deg);
  }

  .main-nav .seasonal-child-link {
    display: block !important;

    padding: 13px 16px !important;
    margin: 6px 0 !important;

    background: #9dad7f !important;
    color: #ffffff !important;

    border: none !important;
    border-radius: 14px !important;

    font-family: "Quicksand", sans-serif !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    line-height: 1.6 !important;

    text-decoration: none !important;
    box-sizing: border-box;
  }

  .main-nav .seasonal-child-link:hover {
    background: #8c9a72 !important;
    color: #ffffff !important;
  }
</style>


<a
  class="menu-collection-link"
  href="/pages/about-us"
>
  About Us
</a>

</nav>

    <div class="header-icons">

      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/>
          </svg>
        </a>
      {% endif %}

      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 8h12l-1 12H7L6 8z"/>
          <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
        </svg>

        {% if cart.item_count > 0 %}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>

    </div>

  </div>
</header>

<style>
  .seasonal-menu {
  width: 100%;
  margin: 0;
}

.seasonal-menu-toggle {
  width: 100%;
  background: #e9cfcf;
  border: none;
  border-radius: 18px;
  padding: 18px 28px;
  font: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  box-sizing: border-box;
}

.seasonal-menu-toggle:hover {
  opacity: 0.95;
}

.seasonal-arrow {
  margin-left: 8px;
  font: inherit;
  transition: transform 0.2s ease;
}

.seasonal-menu.open .seasonal-arrow {
  transform: rotate(180deg);
}

.seasonal-submenu {
  display: none;
  padding: 10px 0 0 14px;
}

.seasonal-menu.open .seasonal-submenu {
  display: block;
}

.seasonal-submenu a {
  display: block;
  background: #f3dddd;
  border: none;
  border-radius: 16px;
  padding: 14px 20px;
  margin-bottom: 10px;
  color: inherit;
  text-decoration: none;
  font: inherit;
  font-size: inherit;
  font-weight: inherit;
  box-sizing: border-box;
}

.seasonal-submenu a:hover {
  opacity: 0.95;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const button = document.getElementById('menuBtn-{{ section.id }}');
  const nav = document.getElementById('mainNav-{{ section.id }}');

  if (button && nav) {
    button.addEventListener('click', function () {
      const isOpen = nav.classList.toggle('nav-open');
      button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }

  const seasonalMenu = document.querySelector('.seasonal-menu');
  const seasonalToggle = document.querySelector('.seasonal-menu-toggle');

  if (seasonalMenu && seasonalToggle) {
    seasonalToggle.addEventListener('click', function () {
      const isOpen = seasonalMenu.classList.toggle('open');
      seasonalToggle.setAttribute(
        'aria-expanded',
        isOpen ? 'true' : 'false'
      );
    });
  }
});
</script>
      
      {% schema %}
{
  "name": "Lil Stitch Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "✨ Free Shipping on Orders Over $150 ✨"
    },
    {
      "type": "image_picker",
      "id": "header_logo",
      "label": "Header logo"
    },
    {
      "type": "text",
      "id": "logo_main",
      "label": "Logo name",
      "default": "Lil Stitch Studio"
    },
    {
      "type": "text",
      "id": "logo_sub",
      "label": "Logo subtitle",
      "default": "cute • cozy • made with love"
    },
    {
      "type": "url",
      "id": "custom_orders_url",
      "label": "Custom Orders link"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About Us link"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQ link"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Menu Collection",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Collection name",
          "default": "Baby & Kids"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Alternative link"
        }
      ]
    }
  ]
}
{% endschema %}
